    "units = int(input(\"enter the number of units: \"))\n",
    "total_bill = 0\n",
    "if units>=0 and units<=100:\n",
    "    total_bill += units*5\n",
    "if units>100 and units<=200:\n",
    "    total_bill += units*7\n",
    "if units>200:\n",
    "    total_bill += units*10\n",
    "\n",
    "print(f\"the total bill is {total_bill} rupees\")"
